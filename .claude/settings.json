{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin main*)",
      "Bash(git push --delete*)",
      "Bash(git reset --hard*)",
      "Bash(git checkout -- .*)",
      "Bash(git restore .*)",
      "Bash(git clean*)",
      "Bash(git branch -D*)",
      "Bash(git rebase -i*)",
      "Bash(git commit --amend*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr review --approve*)",
      "Bash(rm -rf *)",
      "Read(./.env)",
      "Read(./**/.env)",
      "Edit(./.env)",
      "Write(./.env)"
    ],
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch --show-current*)",
      "Bash(git fetch*)",
      "Bash(git switch -c *)",
      "Bash(git add *)",
      "Bash(git commit -m *)",
      "Bash(git push -u origin core/*)",
      "Bash(git push -u origin docs/*)",
      "Bash(git push -u origin infra/*)",
      "Bash(git push -u origin contracts/*)",
      "Bash(git push -u origin localization/*)",
      "Bash(git push -u origin navigation/*)",
      "Bash(git push -u origin course/*)",
      "Bash(gh pr create*)",
      "Bash(gh issue create*)",
      "Bash(gh pr edit*)",
      "Bash(make board*)",
      "Bash(make review-queue*)",
      "Bash(make claim*)",
      "Bash(make labels*)",
      "Bash(make devlog*)",
      "Bash(make merge-reviewed N=*)"
    ]
  }
}
