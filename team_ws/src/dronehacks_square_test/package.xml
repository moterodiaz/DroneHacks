<?xml version="1.0"?>
<package format="3">
  <name>dronehacks_square_test</name>
  <version>0.1.0</version>
  <description>Cage test: take off, 0.5 m box with holds on cuVSLAM, touch-and-go, land and disarm. Built on the kit's competitor_example.</description>
  <maintainer email="linchenyoung1126@gmail.com">TheSleepyPP</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>px4_msgs</exec_depend>
  <exec_depend>skybeta_flight_interface</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
