<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dronehacks_autonomy</name>
  <version>0.1.0</version>
  <description>
    Map-driven autonomy for the Sky Beta: read a contracts/course.md map, plan with A*, smooth,
    profile the speed and fly it through the kit's flight interface. A new course is a new map file.
    Reads /fmu/out/* only and never writes /fmu/in/*.
  </description>
  <maintainer email="noreply@example.com">DroneHacks team</maintainer>
  <license>Proprietary</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>px4_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>skybeta_flight_interface</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
