<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dronehacks_course_follower</name>
  <version>0.1.0</version>
  <description>Map-planned course route flown with smooth led pose setpoints, a look-ahead heading and a twist landing on the pad</description>
  <maintainer email="michael.baron@neros.tech">Michael Bar On</maintainer>
  <license>MIT</license>
  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <exec_depend>python3-numpy</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
